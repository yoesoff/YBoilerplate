<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- ============================ -->
    <!-- 02. Create sales table       -->
    <!-- ============================ -->
    <changeSet id="06-create-sales" author="Yusuf Ibrahim">

        <createTable tableName="sales">
            <column name="id" type="BINARY(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="customer_name" type="VARCHAR(100)"/>

            <column name="total_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

    </changeSet>


    <!-- ============================ -->
    <!-- 03. Create sale_items table  -->
    <!-- ============================ -->
    <changeSet id="07-create-sale-items" author="Yusuf Ibrahim">

        <createTable tableName="sale_items">
            <column name="id" type="BINARY(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="sale_id" type="BINARY(16)">
                <constraints nullable="false" foreignKeyName="fk_sale_items_sales"
                             referencedTableName="sales" referencedColumnNames="id"/>
            </column>

            <column name="variant_id" type="BINARY(16)">
                <constraints nullable="false" foreignKeyName="fk_sale_items_variants"
                             referencedTableName="variants" referencedColumnNames="id"/>
            </column>

            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="subtotal" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Optional: add index for performance -->
        <createIndex tableName="sale_items" indexName="idx_sale_items_sale_id">
            <column name="sale_id"/>
        </createIndex>

        <createIndex tableName="sale_items" indexName="idx_sale_items_variant_id">
            <column name="variant_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
